{
  "name": "finance-hub",
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "postinstall": "electron-rebuild",
    "ng": "ng",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"npm run dev\" \"npm run electron:watch\"",
    "electron:watch": "wait-on http://localhost:4200 && npm run electron:compile && cross-env NODE_ENV=development electron .",
    "electron:build": "npm run build && npm run electron:compile",
    "electron:package": "npm run electron:build && electron-builder --config electron-builder.json",
    "electron:package:win": "npm run electron:build && electron-builder --win --config electron-builder.json",
    "electron:package:mac": "npm run electron:build && electron-builder --mac --config electron-builder.json",
    "electron:package:linux": "npm run electron:build && electron-builder --linux --config electron-builder.json"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "dependencies": {
    "@angular/cdk": "^21.2.13",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.5.1",
    "drizzle-orm": "^0.45.2",
    "material-symbols": "^0.44.11",
    "ofx-data-extractor": "^1.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler-cli": "^21.1.0",
    "@electron/rebuild": "^4.0.4",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^41.7.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.10"
  }
}
